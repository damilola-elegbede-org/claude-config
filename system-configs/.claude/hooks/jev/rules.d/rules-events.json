{
  "file-org-guard": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "pr-draft-guard": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "retry-counter": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "papercut-grep": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "executive-lint": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "scope": ["interactive", "bgjob"],
    "max_lines": 60
  },
  "link-lint": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "scope": ["interactive", "bgjob"]
  },
  "link-validate": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "scope": ["interactive", "bgjob"]
  },
  "postcompact-log": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "stopfailure-hint": { "mode": "enforce", "scope": ["interactive"] },
  "pr-landing-gate": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"],
    "max_blocks": 3,
    "review_grace_min": 15,
    "review_bots": ["coderabbitai", "chatgpt-codex-connector"]
  },

  "executive-tag-correctness": {
    "mode": { "interactive": "shadow", "bgjob": "shadow" },
    "threshold": 0.9,
    "scope": ["interactive", "bgjob"]
  },
  "executive-unsourced-claims": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.85,
    "scope": ["interactive", "bgjob"]
  },
  "executive-scope-creep": {
    "mode": { "interactive": "shadow", "bgjob": "shadow" },
    "threshold": 0.9,
    "scope": ["interactive", "bgjob"]
  },
  "papercut-nudge": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "papercut-dedupe": {
    "mode": "enforce",
    "threshold": 0.9,
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "memory-dup-guard": {
    "mode": "enforce",
    "threshold": 0.9,
    "scope": ["interactive"]
  },
  "stopfailure-classify": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "session-project-memories": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "session-end-memory": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "notification-urgency": {
    "mode": "enforce",
    "threshold": 0.5,
    "scope": ["interactive"]
  },

  "workflow-linear-presort": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.5,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-commit-type": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-commit-mixed": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.8,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-branch-type": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-review-depth": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "scope": ["interactive", "bgjob"]
  },
  "workflow-ci-class": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-verify-class": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-click-target": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  }
