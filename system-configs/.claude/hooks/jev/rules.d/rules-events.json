{
  "file-org-guard": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "pr-draft-guard": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "retry-counter": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "papercut-grep": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "executive-lint": {
    "mode": { "interactive": "enforce", "bgjob": "enforce" },
    "scope": ["interactive", "bgjob"],
    "max_lines": 60,
    "bgjob_tag_min_chars": 500,
    "linear_issue_url": "https://linear.app/bareclaude/issue"
  },
  "executive-lint-meta": {
    "mode": { "interactive": "enforce", "bgjob": "enforce" },
    "scope": ["interactive", "bgjob"]
  },
  "executive-lint-bare-id": {
    "mode": { "interactive": "enforce", "bgjob": "enforce" },
    "scope": ["interactive", "bgjob"]
  },
  "link-lint": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "scope": ["interactive", "bgjob"]
  },
  "link-validate": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "scope": ["interactive", "bgjob"]
  },
  "postcompact-log": {
    "mode": "enforce",
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "stopfailure-hint": { "mode": "enforce", "scope": ["interactive"] },

  "executive-tag-correctness": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.9,
    "scope": ["interactive", "bgjob"]
  },
  "executive-unsourced-claims": {
    "mode": { "interactive": "shadow", "bgjob": "shadow" },
    "threshold": 0.92,
    "scope": ["interactive", "bgjob"]
  },
  "executive-scope-creep": {
    "mode": { "interactive": "shadow", "bgjob": "shadow" },
    "threshold": 0.9,
    "flash_threshold": 0.95,
    "scope": ["interactive", "bgjob"]
  },
  "papercut-nudge": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "papercut-dedupe": {
    "mode": "enforce",
    "threshold": 0.9,
    "scope": ["interactive", "bgjob", "fleet"]
  },
  "memory-dup-guard": {
    "mode": "enforce",
    "threshold": 0.9,
    "scope": ["interactive"]
  },
  "stopfailure-classify": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "session-project-memories": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "session-end-memory": {
    "mode": "enforce",
    "threshold": 0.8,
    "scope": ["interactive"]
  },
  "notification-urgency": {
    "mode": "enforce",
    "threshold": 0.5,
    "scope": ["interactive"]
  },

  "workflow-linear-presort": {
    "mode": { "interactive": "enforce", "bgjob": "enforce" },
    "threshold": 0.5,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-commit-type": {
    "mode": { "interactive": "enforce", "bgjob": "enforce" },
    "threshold": 0.8,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-commit-mixed": {
    "mode": { "interactive": "enforce", "bgjob": "enforce" },
    "threshold": 0.8,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-branch-type": {
    "mode": { "interactive": "shadow", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-review-depth": {
    "mode": { "interactive": "enforce", "bgjob": "enforce" },
    "scope": ["interactive", "bgjob"]
  },
  "workflow-ci-class": {
    "mode": { "interactive": "shadow", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-verify-class": {
    "mode": { "interactive": "shadow", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  },
  "workflow-click-target": {
    "mode": { "interactive": "enforce", "bgjob": "shadow" },
    "threshold": 0.7,
    "scope": ["interactive", "bgjob"]
  }
}
