{
  "_comment": "Decision-gate rules for hooks/gate.sh. Patterns are jq (Oniguruma) regexes written in the POSIX ERE subset plus lookahead/lookbehind where needed. Macros ({{SEP}} {{PFX}} {{GIT}} {{EXTOK}} {{LIVE}} and dynamic {{HOME}} {{TMPDIR}} {{JOBDIR}}) are expanded before matching. anchor=cmd wraps the pattern as SEP(?<c>PFX pattern rest-of-segment) so it only matches in command position; exempt is tested against that capture (or the whole match). exempt_all is tested against the whole field. Rules apply in file order; every matching rule is evaluated, the first enforced one names the CHECKPOINT and the others are listed as Also matched, and ONE approval (bound to tool + exact command/path+content + cwd + scope) clears them all. Before matching, heredoc bodies (unless fed to a shell) and quoted data (echo/printf/grep arguments, --body/--title/-m/-f body= values) are blanked; SEP also matches shell -c in any combined-flag form (bash -lc). Per-rule: scope (interactive|bgjob|fleet), lanes (fleet agent slug -> allow), enforce (false = log as shadow only). exempt_agents are never blocked (their would-be decision is logged).",
  "exempt_agents": ["dara", "clara"],
  "macros": {
    "SEP": "(?:^|[;&|(\\n`]|\\$\\(|-c[[:space:]]+[\\\"']|(?<![A-Za-z0-9_-])(?:ba|z|da|k)?sh[[:space:]]+(?:-[^[:space:]]+[[:space:]]+)*-[A-Za-z]*c[[:space:]]+[\\\"']|-exec(?:dir)?[[:space:]]+)[[:space:]]*",
    "PFX": "(?:[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*(?:(?:sudo|doas|env|command|exec|time|nohup|xargs|npx|then|do|else|elif|if|while|until|!)[[:space:]]+(?:-[^[:space:]]+[[:space:]]+)*(?:[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*)*",
    "GIT": "(?:git|(?:[^[:space:]]*/)?git-agent\\.sh[[:space:]]+[A-Za-z0-9_-]+)(?:[[:space:]]+-{1,2}[A-Za-z][^[:space:]]*(?:[[:space:]]+[^[:space:]-][^[:space:]]*)?)*[[:space:]]+",
    "EXTOK": "[\\\"']?(?![^[:space:]]*\\.\\.)(?:(?:{{TMPDIR}}|{{JOBDIR}}|/private/tmp|/tmp|\\$TMPDIR|\\$\\{TMPDIR\\}|\\$CLAUDE_JOB_DIR|\\$\\{CLAUDE_JOB_DIR\\})(?:/[^[:space:]]*)?|(?:[^[:space:]]*/)?(?:\\.tmp|node_modules|dist|build|__pycache__|\\.pytest_cache)(?:/[^[:space:]]*)?)[\\\"']?(?=[[:space:]]|$)",
    "LIVE": "(?:~|\\\"?\\$\\{?HOME\\}?\\\"?|{{HOME}})/\\.claude/",
    "LIVEGUARDED": "{{LIVE}}(?:gate\\.off|jev\\.off|gate-approved|gate-pending|gate-asks-used|gate-log\\.jsonl|jev/decisions\\.jsonl|settings\\.json|hooks(?:/|(?=[[:space:]]|$)))",
    "GATESTATE": "(?:gate\\.off|jev\\.off|gate-approved|gate-pending|gate-asks-used|gate-log\\.jsonl|jev/decisions\\.jsonl)"
  },
  "rules": [
    {
      "id": "MG-vercel-pin",
      "class": "memory-gotcha",
      "description": "vercel deploy/env/promote/link/rm without --project or VERCEL_PROJECT_ID=",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "vercel(?:[[:space:]]+(?:deploy|promote|link|rm|remove|env[[:space:]]+(?:add|rm|remove|update|pull)|--prod(?:uction)?)(?=[[:space:]]|$)|(?=[[:space:]]*(?:$|[;&|])))",
      "anchor": "cmd",
      "exempt": "(?:^|[[:space:]])VERCEL_PROJECT_ID=|[[:space:]](?:--project|-p)(?:[[:space:]]|=)",
      "exempt_all": "VERCEL_PROJECT_ID=",
      "action": "deny",
      "message": "Shell pins VERCEL_PROJECT_ID to alocubano; pass the project explicitly (--project <name> or VERCEL_PROJECT_ID=<id> prefix)",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "MG-codex-npm",
      "class": "memory-gotcha",
      "description": "npm install of @openai/codex",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "npm[[:space:]]+(?:i|install|add)[[:space:]]+(?:(?:-g|--global)[[:space:]]+)?@openai/codex",
      "anchor": "cmd",
      "action": "deny",
      "message": "Codex is a brew cask: brew upgrade codex",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "MG-libsql-temp",
      "class": "memory-gotcha",
      "description": "CREATE TEMP TABLE in a command (Turso remote rejects it)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "CREATE[[:space:]]+TEMP(?:ORARY)?[[:space:]]+TABLE",
      "flags": "i",
      "exempt_all": "^[[:space:]]*(?:git[[:space:]]+(?:commit|log|grep|show)|grep|rg|ag)[[:space:]][^;&]*$",
      "action": "deny",
      "message": "Turso/libsql remote rejects CREATE TEMP TABLE; use a regular table or in-memory structure",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "MG-hook-env",
      "class": "memory-gotcha",
      "description": "Write/Edit content reading $CLAUDE_TOOL_INPUT (hooks get JSON on stdin)",
      "tools": "^(?:Write|Edit|MultiEdit)$",
      "field": "content",
      "pattern": "\\$\\{?CLAUDE_TOOL_INPUT",
      "exempt_path": "(?:\\.(?:md|txt)$|/tests?/|/test[_-][^/]*$|gate-rules\\.json$|/\\.claude/projects/)",
      "action": "deny",
      "message": "hooks get JSON on stdin, not $CLAUDE_TOOL_INPUT; read it with INPUT=$(cat) and jq",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "MG-numeric-settings",
      "class": "memory-gotcha",
      "description": "settings*.json with a quoted number for a numeric setting",
      "tools": "^(?:Write|Edit|MultiEdit)$",
      "field": "content",
      "pattern": "\\\"(?:autoCompactWindow|cleanupPeriodDays|feedbackSurveyRate)\\\"[[:space:]]*:[[:space:]]*\\\"[0-9]",
      "path": "(?:^|/)settings[^/]*\\.json$",
      "action": "deny",
      "message": "numeric settings must be numbers: a quoted value silently never applies",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G1-rm",
      "class": "G1",
      "description": "rm with a recursive flag, unless every target is a scratch path",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:/(?:usr/)?bin/)?rm(?:[[:space:]]+[^;&|\\n]*?)?[[:space:]]+(?:-[A-Za-z]*[rR][A-Za-z]*|--recursive)(?=[[:space:]]|$)",
      "anchor": "cmd",
      "exempt": "^{{PFX}}(?:/(?:usr/)?bin/)?rm(?:[[:space:]]+-[^[:space:]]+)*(?:[[:space:]]+{{EXTOK}})(?:[[:space:]]+(?:-[^[:space:]]+|{{EXTOK}}))*[[:space:]]*$",
      "action": "deny",
      "message": "recursive rm outside scratch paths (/tmp, $TMPDIR, .tmp/, node_modules, dist, build, __pycache__, .pytest_cache, $CLAUDE_JOB_DIR)",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G1-find",
      "class": "G1",
      "description": "find ... -delete, unless the search root is a scratch path",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "find(?:[[:space:]]+[^;&|\\n]*?)?[[:space:]]+-delete(?=[[:space:]]|$)",
      "anchor": "cmd",
      "exempt": "^{{PFX}}find[[:space:]]+{{EXTOK}}",
      "action": "deny",
      "message": "find -delete removes files without a recycle step",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G1-trunc",
      "class": "G1",
      "description": "truncate, shred, dd of=",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:truncate|shred)(?=[[:space:]])|dd(?:[[:space:]]+[^;&|\\n]*)?[[:space:]]of=",
      "anchor": "cmd",
      "exempt": "of=/dev/null(?=[[:space:]]|$)|(?:^|[[:space:]])(?:of=)?{{EXTOK}}[[:space:]]*$",
      "action": "deny",
      "message": "truncate/shred/dd of= overwrite file contents irreversibly",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G1-interp",
      "class": "G1",
      "description": "inline interpreter code that deletes files (python -c, node -e, perl -e, ruby -e, php -r, or a heredoc fed to one)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?<![A-Za-z0-9_.-])(?:python[0-9.]*|node(?:js)?|deno|bun|perl|ruby|php)(?:(?:[[:space:]]+-[^[:space:]]+)*[[:space:]]+(?:-[A-Za-z]*[cepEr][A-Za-z]*|--eval|--print)|(?:[[:space:]]+-)?[[:space:]]*<<-?)(?=[[:space:]\\\"'])(?:.|\\n){0,800}?(?:shutil\\.rmtree|\\brmtree\\b|\\bremove_tree\\b|\\bos\\.(?:remove|unlink|rmdir|removedirs)\\b|\\.(?:unlink|rmdir)\\(|\\b(?:rmSync|rmdirSync|unlinkSync|rimraf)\\b|\\bfs\\.(?:promises\\.)?(?:rm|rmdir|unlink)\\(|\\bFileUtils\\.(?:rm_rf?|rm_r|remove_entry(?:_secure)?)\\b|\\bFile\\.delete\\b|\\bDir\\.rmdir\\b|\\bunlink[[:space:]]*\\(?[[:space:]]*[\\\"'$]|(?<![A-Za-z0-9_-])rm[[:space:]]+-[A-Za-z]*[rR])",
      "action": "deny",
      "message": "inline interpreter code deletes files (rmtree/os.remove/fs.rmSync/unlink/...), the same irreversible class as rm -rf; script FILES that delete are not inspected",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G2-push-main",
      "class": "G2",
      "description": "git push to main/master (incl. HEAD:main)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "{{GIT}}push(?=[[:space:]])[^;&|\\n]*[[:space:]:+](?:refs/heads/)?(?:main|master)(?=[[:space:]]|$)",
      "anchor": "cmd",
      "action": "deny",
      "message": "pushing to main/master publishes straight to the shared branch",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G2-push-delete",
      "class": "G2",
      "description": "git push --delete / -d / origin :branch (also deleted tags)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "{{GIT}}push(?=[[:space:]])[^;&|\\n]*(?:[[:space:]]--delete(?=[[:space:]]|$)|[[:space:]]-d(?=[[:space:]]|$)|[[:space:]]\\+?:[A-Za-z0-9_./-]+)",
      "anchor": "cmd",
      "action": "deny",
      "message": "deleting a remote branch or tag is hard to reverse",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G2-tag-delete",
      "class": "G2",
      "description": "git tag -d / --delete",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "{{GIT}}tag(?=[[:space:]])(?:[[:space:]]+[^;&|\\n]*?)?[[:space:]]+(?:-d|--delete)(?=[[:space:]]|$)",
      "anchor": "cmd",
      "action": "deny",
      "message": "deleting a tag loses the release pointer",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G2-stash",
      "class": "G2",
      "description": "bare git stash pop / drop, and stash clear (the stash is shared across worktrees)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "{{GIT}}stash[[:space:]]+(?:clear(?=[[:space:]]|$)|(?:pop|drop)(?:[[:space:]]+-[^[:space:]]+)*(?=[[:space:]]*(?:$|[;&|)]|[0-9]?>)))",
      "anchor": "cmd",
      "action": "deny",
      "message": "the stash stack is shared by all sessions; use `git stash apply <sha>` and drop by explicit stash@{n}",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G3",
      "class": "G3",
      "description": "gh pr merge",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "gh[[:space:]]+(?:(?:-R|--repo)[[:space:]]+[^[:space:]]+[[:space:]]+)?pr[[:space:]]+merge(?=[[:space:]]|$)",
      "anchor": "cmd",
      "action": "deny",
      "message": "merging a PR is a decision for D (or Dara's lane); /process-linear approvals are records, not execution orders",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {
        "dara": "allow"
      },
      "enforce": true
    },
    {
      "id": "G3-api",
      "class": "G3",
      "description": "gh api merge endpoints / mergePullRequest mutation",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "gh[[:space:]]+api[[:space:]]+[^;&|\\n]*?(?:/pulls/[^/[:space:]]+/merge(?=[[:space:]\\\"'?]|$)|/merges?(?=[[:space:]\\\"'?]|$)|mergePullRequest|enablePullRequestAutoMerge)",
      "anchor": "cmd",
      "exempt": "(?:-X|--method)[[:space:]]+GET",
      "action": "deny",
      "message": "merging a PR through the API is still a merge",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {
        "dara": "allow"
      },
      "enforce": true
    },
    {
      "id": "G4",
      "class": "G4",
      "description": "vercel --prod, promote, rollback, remove/rm, env add/rm, domains, dns",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "vercel[[:space:]]+(?:(?:promote|rollback|remove|rm|domains|dns|env[[:space:]]+(?:add|rm|remove))(?=[[:space:]]|$)|[^;&|\\n]*?--prod(?:uction)?(?=[[:space:]]|$))",
      "anchor": "cmd",
      "exempt": "^{{PFX}}vercel[[:space:]]+(?:build|logs|inspect|ls|list)(?=[[:space:]]|$)",
      "action": "deny",
      "message": "production deploy/infra change",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G4-mcp",
      "class": "G4",
      "description": "Vercel MCP deploy/promote/rollback/edit/update/delete tools",
      "tools": "^mcp__.*Vercel.*__(?:create_deployment|request_promote|request_rollback|start_rolling_release|complete_rolling_release|approve_rolling_release_stage|update_[a-z0-9_]*|edit_[a-z0-9_]*|add_project_domain|create_project_env|edit_project_env|put_firewall_config|update_firewall_config|replace_domains[a-z0-9_]*|pause_project|unpause_project|delete[a-z0-9_]*|restore_edge_config_backup|patch_edge_config_items)$",
      "flags": "i",
      "action": "deny",
      "message": "production deploy/infra change through the Vercel connector",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G5-sql",
      "class": "G5",
      "description": "DROP TABLE/DATABASE/SCHEMA/INDEX, TRUNCATE, DELETE FROM without WHERE, ALTER TABLE ... DROP",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "DROP[[:space:]]+(?:TABLE|DATABASE|SCHEMA|INDEX)(?=[[:space:]]|$|;)|TRUNCATE[[:space:]]+(?:TABLE[[:space:]]+)?[A-Za-z_\\\"`\\[][^;\\\"'\\n]*|DELETE[[:space:]]+FROM[[:space:]]+[^;\\\"']*|ALTER[[:space:]]+TABLE[[:space:]]+[^;\\\"'\\n]*?[[:space:]]DROP(?=[[:space:]]|$)",
      "flags": "i",
      "exempt": "^DELETE[[:space:]]+FROM[[:space:]]+[^;\\\"']*[[:space:]]WHERE[[:space:](]",
      "exempt_all": "^[[:space:]]*(?:git[[:space:]]+(?:commit|log|grep|show)|grep|rg|ag)[[:space:]][^;&]*$",
      "action": "deny",
      "message": "destructive SQL against a data store",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G5-turso",
      "class": "G5",
      "description": "turso db destroy / shell",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "turso[[:space:]]+db[[:space:]]+(?:destroy|shell)(?=[[:space:]]|$)",
      "anchor": "cmd",
      "action": "deny",
      "message": "direct Turso database access can destroy or rewrite production data",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G6",
      "class": "G6",
      "description": "MCP tools that buy, purchase, or subscribe (Vercel buy_*, create_or_transfer_domain)",
      "tools": "^mcp__.*(?:__buy|purchase|subscribe|create_or_transfer_domain)",
      "flags": "i",
      "exempt": "__(?:get|list|search|read)_",
      "action": "deny",
      "message": "this tool spends money",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G7-gmail",
      "class": "G7",
      "description": "Gmail send_message / reply / forward",
      "tools": "^mcp__.*Gmail.*__(?:send_message|reply|forward)$",
      "flags": "i",
      "action": "deny",
      "message": "sending email goes out as D",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {
        "clara": "allow"
      },
      "enforce": true
    },
    {
      "id": "G7-slack",
      "class": "G7",
      "description": "Slack send / schedule message, create/update canvas (drafts allowed)",
      "tools": "^mcp__.*Slack.*__(?:slack_send_message|slack_schedule_message|slack_create_canvas|slack_update_canvas)$",
      "flags": "i",
      "action": "deny",
      "message": "posting to Slack goes out as D",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G7-cal",
      "class": "G7",
      "description": "Calendar create/update/delete/respond",
      "tools": "^mcp__.*Google_Calendar.*__(?:create_event|update_event|delete_event|respond_to_event)$",
      "flags": "i",
      "action": "deny",
      "message": "calendar changes send invites or notify attendees",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G7-gh",
      "class": "G7",
      "description": "gh pr|issue comment|review (shadow: log-only so the PR review-reply workflow is not blocked)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "gh[[:space:]]+(?:(?:-R|--repo)[[:space:]]+[^[:space:]]+[[:space:]]+)?(?:pr|issue)[[:space:]]+(?:comment|review)(?=[[:space:]]|$)",
      "anchor": "cmd",
      "action": "deny",
      "message": "posting a GitHub comment/review goes out as D",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": false
    },
    {
      "id": "G7-gh-api",
      "class": "G7",
      "description": "gh api .../comments with POST or a body field (shadow: log-only so the PR review-reply workflow is not blocked)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "gh[[:space:]]+api(?=[[:space:]])(?=[^;&|\\n]*comments)(?=[^;&|\\n]*(?:(?:-X|--method)[[:space:]]+(?:POST|post)|(?:-f|-F|--field|--raw-field)[[:space:]]+body))",
      "anchor": "cmd",
      "action": "deny",
      "message": "posting a GitHub comment through the API goes out as D",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": false
    },
    {
      "id": "G8-drive",
      "class": "G8",
      "description": "Drive share_file",
      "tools": "^mcp__.*Google_Drive.*__share_file$",
      "flags": "i",
      "action": "deny",
      "message": "sharing a file changes who can read it",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G8-bash",
      "class": "G8",
      "description": "gh repo edit --visibility, chmod 777",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:gh[[:space:]]+repo[[:space:]]+edit(?:[[:space:]]+[^;&|\\n]*?)?[[:space:]]--visibility(?=[[:space:]]|$)|chmod[[:space:]]+(?:-[A-Za-z]+[[:space:]]+)*(?:0?777|a\\+rwx|ugo\\+rwx)(?=[[:space:]]|$))",
      "anchor": "cmd",
      "action": "deny",
      "message": "changes repo visibility or opens file permissions to everyone",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G9",
      "class": "G9",
      "description": "gh secret set, keychain add/delete, vercel env pull, cat/less/head/tail of .env files",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:gh[[:space:]]+secret[[:space:]]+set(?=[[:space:]]|$)|security[[:space:]]+(?:add|delete)-generic-password(?=[[:space:]]|$)|vercel[[:space:]]+env[[:space:]]+pull(?=[[:space:]]|$)|(?:cat|less|more|head|tail|bat)(?:[[:space:]]+[^;&|\\n]*?)?[[:space:]]+[\\\"']?(?:[^[:space:];&|\\\"']*/)?\\.env(?!(?:[A-Za-z0-9_]|\\.(?:example|sample|template|test)(?![A-Za-z0-9_.-]))))",
      "anchor": "cmd",
      "action": "deny",
      "message": "reads or writes secrets (.env files are exempt only as .example/.sample/.template/.test)",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G10-bash",
      "class": "G10",
      "description": "sudo, curl|sh, wget|sh, npm install -g",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:sudo(?=[[:space:]]|$)|(?:curl|wget)[[:space:]][^;&\\n]*\\|[[:space:]]*(?:sudo[[:space:]]+)?(?:ba|z|da)?sh(?=[[:space:]]|$)|npm[[:space:]]+(?:(?:i|install|add)[[:space:]]+(?:[^;&|\\n]*[[:space:]])?(?:-g|--global)|(?:-g|--global)[[:space:]]+(?:i|install|add))(?=[[:space:]]|$))",
      "anchor": "cmd",
      "action": "deny",
      "message": "privilege escalation, piped remote execution, or a global install",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G10-file",
      "class": "G10",
      "description": "Write/Edit to live ~/.claude/hooks/, settings.json, gate state (anchored on $HOME)",
      "tools": "^(?:Write|Edit|MultiEdit)$",
      "field": "file_path",
      "pattern": "^{{HOME}}/\\.claude/(?:hooks/|settings\\.json$|gate\\.off$|jev\\.off$|gate-approved/|gate-pending/|gate-asks-used(?:\\.d/|$)|gate-log\\.jsonl$|jev/decisions\\.jsonl$)",
      "action": "deny",
      "message": "live hooks/settings are edited through claude-config (branch, PR, sync) and the gate state is off limits to agents",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G10-tamper",
      "class": "G10",
      "description": "Bash that creates, edits, moves or removes live hooks/settings.json or the gate's own state (gate.off, jev.off, approvals, log): any verb incl. mkdir; cp/rsync/install only when the guarded path is the DESTINATION; bare names (cd ~/.claude && touch gate.off) when the command mentions .claude",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:^|[^A-Za-z0-9_])(?:touch|tee|mv|rm|ln|mkdir|truncate|dd|chmod|chown|sed[[:space:]]+-i[^[:space:]]*|perl[[:space:]]+-[a-z]*i[^[:space:]]*)(?=[[:space:]])[^;&|\\n]*{{LIVEGUARDED}}|(?:^|[^A-Za-z0-9_])(?:cp|rsync|install)(?=[[:space:]])[^;&|\\n]*[[:space:]\\\"']{{LIVEGUARDED}}[^[:space:];&|\\n]*[\\\"']?(?:[[:space:]]+[0-9]?>>?&?[^[:space:];&|]*)*[[:space:]]*(?=$|[;&|\\n])|>>?[^;&|\\n]*{{LIVEGUARDED}}|\\.claude[^\\n]*[^A-Za-z0-9_](?:touch|tee|mv|rm|ln|mkdir|truncate|chmod|chown|cp|install|rsync)(?=[[:space:]])[^;&|\\n]*[[:space:]\\\"']{{GATESTATE}}(?=[[:space:]\\\"'/;&|]|$)|\\.claude[^\\n]*>>?[[:space:]]*[\\\"']?{{GATESTATE}}(?=[[:space:]\\\"'/;&|]|$)",
      "action": "deny",
      "message": "agents must not disable or tamper with the gate, the live hooks, or live settings",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G11-bash",
      "class": "G11",
      "description": "launchctl load/bootstrap/enable, crontab (except -l)",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:launchctl[[:space:]]+(?:load|bootstrap|enable)(?=[[:space:]]|$)|crontab(?=[[:space:]]|$)(?![[:space:]]+-l(?:[[:space:]]|$)))",
      "anchor": "cmd",
      "exempt": "^{{PFX}}crontab[[:space:]]+-l(?=[[:space:]]|$)",
      "action": "deny",
      "message": "installs a persistent or scheduled job",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G11-tool",
      "class": "G11",
      "description": "CronCreate / RemoteTrigger (read-only actions exempt; ScheduleWakeup is not matched)",
      "tools": "^(?:CronCreate|RemoteTrigger)$",
      "exempt_fields": {
        "action": "^(?:list|get|status)$"
      },
      "action": "deny",
      "message": "creates a scheduled or remote trigger (untested against the real tool_input schema)",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G12-file",
      "class": "G12",
      "description": "Write/Edit to the live files sync replaces (skills, agents, output-styles, CLAUDE.md, runtime scripts)",
      "tools": "^(?:Write|Edit|MultiEdit)$",
      "field": "file_path",
      "pattern": "^{{HOME}}(?:/\\.claude/(?:skills/|agents/|output-styles/|CLAUDE\\.md$|statusline\\.sh$|claude-speak\\.sh$|voice-rx\\.sh$|resume_sessions\\.sh$|restart_on_update\\.sh$|papercut\\.sh$|archive-papercuts\\.sh$)|/CLAUDE\\.md$)",
      "action": "deny",
      "message": "live ~/.claude is replaced by sync; change claude-config and run sync instead",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G12-ssh",
      "class": "G12",
      "description": "ssh to a *mbm* host with a write-ish verb",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "(?:^|[^A-Za-z0-9_])ssh[[:space:]](?=[^\\n]*?mbm)(?=[^\\n]*(?:sed[[:space:]]+-i|(?<![A-Za-z0-9_-])(?:tee|cp|mv|rm)(?![A-Za-z0-9_-])|(?<![0-9&])>|git[[:space:]]+(?:commit|push)|systemctl|launchctl))",
      "action": "deny",
      "message": "writing on the fleet node (mbm) by hand; change the repo and sync",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G12-policy",
      "class": "G12",
      "description": "Write/Edit to BareClaude/infra/model-policy.json",
      "tools": "^(?:Write|Edit|MultiEdit)$",
      "field": "file_path",
      "pattern": "(?:^|/)BareClaude/infra/model-policy\\.json$",
      "action": "deny",
      "message": "fleet model policy changes go through the BareClaude repo",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G13-mcp",
      "class": "G13",
      "description": "trash/delete tools (Drive, Gmail, Calendar, Notion)",
      "tools": "^mcp__.*__(?:trash_file|trash_message|trash_thread|delete_draft|delete_label|delete_event|notion-[a-z-]*delete[a-z-]*|notion-move-pages)$",
      "flags": "i",
      "action": "deny",
      "message": "deleting in an external tool",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G13-bash",
      "class": "G13",
      "description": "gh repo delete / gh release delete",
      "tools": "^Bash$",
      "field": "command",
      "pattern": "gh[[:space:]]+(?:repo|release)[[:space:]]+delete(?=[[:space:]]|$)",
      "anchor": "cmd",
      "action": "deny",
      "message": "deleting a repo or release is irreversible",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    },
    {
      "id": "G13-artifact",
      "class": "G13",
      "description": "Artifact tool with action=delete",
      "tools": "^Artifact$",
      "field": "action",
      "pattern": "^delete$",
      "action": "deny",
      "message": "deleting a published artifact breaks its link for everyone",
      "scope": ["interactive", "bgjob", "fleet"],
      "lanes": {},
      "enforce": true
    }
  ]
}
