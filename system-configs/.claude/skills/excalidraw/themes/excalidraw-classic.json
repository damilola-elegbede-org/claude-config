    },
    {
      "slot": "green",
      "fill": "#d5ecda",
      "stroke": "#2f9e44",
      "text": "#1e1e1e",
      "contrast": 13.37
    },
    {
      "slot": "amber",
      "fill": "#fce8cc",
      "stroke": "#f08c00",
      "text": "#1e1e1e",
      "contrast": 13.94
    },
    {
      "slot": "red",
      "fill": "#f9d6d6",
      "stroke": "#e03131",
      "text": "#1e1e1e",
      "contrast": 12.4
    },
    {
      "slot": "violet",
      "fill": "#e1d9f7",
      "stroke": "#6741d9",
      "text": "#1e1e1e",
      "contrast": 12.28
    },
    {
      "slot": "teal",
      "fill": "#cee7eb",
      "stroke": "#0c8599",
      "text": "#1e1e1e",
      "contrast": 12.9
    }
