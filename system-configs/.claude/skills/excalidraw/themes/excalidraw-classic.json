{
  "$schema": "./_schema.json",
  "id": "excalidraw-classic",
  "name": "Excalidraw Classic",
  "mode": "light",
  "authored": "baked",
  "canvas": {
    "background": "#ffffff",
    "panel": "#f5f5f5"
  },
  "ink": {
    "primary": "#1e1e1e",
    "muted": "#868e96",
    "connector": "#1e1e1e"
  },
  "surfaces": [
    {
      "slot": "blue",
