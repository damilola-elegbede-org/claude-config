<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.damilola.claude-resume-sessions</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/resume_sessions.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/resume_sessions.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/resume_sessions.launchd.log</string>
</dict>
</plist>
